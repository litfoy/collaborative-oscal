    "groups": [
      {
        "id": "ac",
        "class": "family",
        "title": "Access Management",
        "controls": [
          {
            "id": "ac-1",
            "class": "sample",
            "title": "Access Policy",
            "params": [
              {"id": "ac-1_prm_1", "label": "policy review frequency", "values": ["annually"]},
              {
                "id": "ac-1_prm_2",
                "label": "policy owner role",
                "select": {"how-many": "one-or-more", "choice": ["Security lead", "IT manager", "Compliance officer"]}
              }
            ],
            "props": [
              {"name": "label", "value": "AC-1"},
              {"name": "sort-id", "value": "ac-01"}
            ],
            "links": [{"href": "#a3d1b2c4-5e6f-4a7b-8c9d-0e1f2a3b4c5d", "rel": "reference", "text": "Sample access policy template"}],
            "parts": [
              {
                "id": "ac-1_smt",
                "name": "statement",
                "prose": "The organization documents an access policy and reviews it {{ insert: param, ac-1_prm_1 }}.",
                "parts": [
                  {"id": "ac-1_smt.a", "name": "item", "props": [{"name": "label", "value": "a."}], "prose": "Define who may request, approve, and revoke access."},
                  {"id": "ac-1_smt.b", "name": "item", "props": [{"name": "label", "value": "b."}], "prose": "Assign the policy to {{ insert: param, ac-1_prm_2 }}."}
                ]
              },
              {
                "id": "ac-1_gdn",
                "name": "guidance",
                "prose": "Keep the policy short enough that people read it.\n\nRecord exceptions with an owner and an expiry date."
              }
            ],
            "controls": [
              {
                "id": "ac-1.1",
                "title": "Policy Exceptions",
                "parts": [
                  {"id": "ac-1.1_smt", "name": "statement", "prose": "Exceptions to the access policy are approved in writing and time limited."}
                ]
              }
            ]
          },
          {
            "id": "ac-2",
            "title": "Account Lifecycle",
            "parts": [
              {"id": "ac-2_smt", "name": "statement", "prose": "Accounts are created, changed, and disabled through a documented process."}
            ]
          }
        ],
        "groups": [
          {
            "id": "ac-priv",
            "title": "Privileged Access",
            "controls": [
              {
                "id": "ac-6",
                "title": "Least Privilege",
                "parts": [
                  {"id": "ac-6_smt", "name": "statement", "prose": "People receive only the access required for their role."}
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "ir",
        "class": "family",
        "title": "Incident Response",
        "controls": [
          {
            "id": "ir-1",
            "title": "Incident Plan",
            "parts": [
              {"id": "ir-1_smt", "name": "statement", "prose": "A documented plan describes how incidents are reported, triaged, and closed."}
            ]
          },
          {
            "id": "ir-2",
            "title": "Incident Exercises",
            "parts": [
              {"id": "ir-2_smt", "name": "statement", "prose": "The plan is exercised and improved {{ insert: param, review-frequency }}."}
            ]
          }
        ]
      }
