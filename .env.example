# Local development only. Replace with a strong secret outside local development.
POSTGRES_DB=collaborative_oscal
POSTGRES_USER=collaborative_oscal
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432

# Public URL used by the browser to reach the API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# JSON array of allowed browser origins for the API.
API_CORS_ORIGINS=["http://localhost:3000"]

# Optional, local-only Keycloak development service. Set these before starting
# the compose profile; these values have no defaults and must not be reused.
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_PORT=8080

# API resource-server configuration; issuer/audience are required to use /api/v1.
OIDC_ISSUER_URL=http://localhost:8080/realms/collaborative-oscal-dev
OIDC_API_AUDIENCE=collaborative-oscal-api
# Optional; if set, it must share the configured issuer's origin.
# OIDC_JWKS_URL=https://identity.example.test/path/to/jwks
OIDC_ALLOWED_ALGORITHMS=["RS256"]
OIDC_CLOCK_SKEW_SECONDS=30
OIDC_ACCESS_TOKEN_PROFILE=custom
OIDC_ACCESS_TOKEN_TYPE_CLAIM=typ
OIDC_ACCESS_TOKEN_TYPE_VALUE=Bearer
OIDC_CLOCK_SKEW_SECONDS=30
OIDC_JWKS_CACHE_SECONDS=300
OIDC_JWKS_REFRESH_COOLDOWN_SECONDS=5
OIDC_HTTP_TIMEOUT_SECONDS=5

# Next.js server (BFF). These are server-only and never exposed to the browser.
APP_PUBLIC_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
WEB_OIDC_CLIENT_ID=collaborative-oscal-web
# Only for confidential clients; the Keycloak dev client is public (PKCE).
# WEB_OIDC_CLIENT_SECRET=
WEB_OIDC_SCOPES=openid profile email offline_access
# Extra authorization parameters as JSON, e.g. to request the API audience.
# WEB_OIDC_AUTHORIZATION_PARAMS={"audience":"collaborative-oscal-api"}
# Generate with: openssl rand -base64 48   (minimum 32 characters)
SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=28800
