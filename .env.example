# Local development only. Replace with a strong secret outside local development.
POSTGRES_DB=collaborative_oscal
POSTGRES_USER=collaborative_oscal
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432

# Public URL used by the browser to reach the API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# JSON array of allowed browser origins for the API.
API_CORS_ORIGINS=["http://localhost:3000"]
